<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Actualizar estados de reservas cada 15 minutos -->
        <record id="ir_cron_actualizar_estados_reservas" model="ir.cron">
            <field name="name">Reserva Canchas: Actualizar Estados</field>
            <field name="model_id" ref="model_reserva_reserva"/>
            <field name="state">code</field>
            <field name="code">model._cron_actualizar_estados()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>